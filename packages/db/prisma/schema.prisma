generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooler (Supabase Transaction mode, port 6543) — used by the app at runtime.
  url       = env("DATABASE_URL")
  // Direct/session connection (port 5432) — used by `prisma db push`/migrations.
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  RECEPTIONIST
  PROFESSIONAL
}

/// Cargo no CRM, à parte do perfil na clínica (como os papéis do Kommo).
/// Nulo no usuário = o padrão do perfil: dono e administrador são Gestor; o
/// resto, Atendente. O dono é sempre Gestor — ver `lib/crm-roles.ts`.
enum CrmRole {
  /// Vê tudo e configura o CRM: funis, robôs, modelos, WhatsApp, equipe e distribuição.
  MANAGER
  /// Atende e move os negócios de todos; não mexe nas configurações.
  AGENT
  /// Vê só os negócios e conversas de que é responsável (e os ainda sem responsável).
  AGENT_OWN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  RESCHEDULED
  CANCELLED
  ATTENDED
  MISSED
}

enum AppointmentType {
  PARTICULAR
  CONVENIO
  CORTESIA
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum DiscountType {
  PERCENT
  FIXED
}

/// Situação de uma marcação do odontograma: a fazer (plano de tratamento),
/// realizado na clínica, ou que o paciente já tinha quando chegou.
enum ToothFindingStatus {
  PLANNED
  DONE
  EXISTING
}

// ─── Models ──────────────────────────────────────────────

model Tenant {
  id            String  @id @default(cuid())
  clerkOrgId    String  @unique
  name          String
  slug          String  @unique
  document      String?
  phone         String?
  email         String?
  /// Endereço em uma linha, montado a partir dos campos abaixo ao salvar.
  /// Existe porque é o que o PDF do orçamento lê — manter a composição aqui
  /// evita que a geração do PDF precise saber como se escreve um endereço.
  address       String?
  zipCode       String?
  street        String?
  addressNumber String?
  complement    String?
  neighborhood  String?
  city          String?
  state         String?
  /// Caminho do logotipo no storage privado (não é URL pública). Os PDFs
  /// baixam os bytes no servidor; a tela de configurações assina um link curto.
  logoUrl       String?

  /// Responsável técnico e o registro dele no conselho (ex.: "CRO-SP 12345").
  /// O conselho exige os dois nos documentos da clínica — saem no rodapé de
  /// assinatura do orçamento, do recibo e do contrato.
  technicalResponsible  String?
  technicalRegistration String?
  /// Condições gerais impressas no fim de todo orçamento. Nulo = texto padrão.
  quoteTerms            String?
  /// Cláusulas próprias da clínica, acrescentadas ao contrato padrão.
  contractTerms         String?

  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  units               ClinicUnit[]
  patients            Patient[]
  professionals       Professional[]
  procedures          Procedure[]
  procedureCategories ProcedureCategory[]
  appointments        Appointment[]
  appointmentLabels   AppointmentLabel[]
  quotes              Quote[]
  messages            WhatsAppMessage[]
  auditLogs           AuditLog[]
  blockedSlots        BlockedSlot[]
  patientNotes        PatientNote[]
  toothFindings       ToothFinding[]
  payments            Payment[]
  anamneses           Anamnesis[]
  evolutions          Evolution[]
  patientFiles        PatientFile[]
  whatsappSession     WhatsAppSession?
  campaigns           Campaign[]
  subscription        Subscription?
  invitations         Invitation[]

  // CRM (etapa 1)
  leads          Lead[]
  pipelines      Pipeline[]
  pipelineStages PipelineStage[]
  leadTasks      LeadTask[]
  leadTags       LeadTag[]
  leadFields     LeadField[]
  leadTagOnLeads LeadTagOnLead[]
  lostReasons    LostReason[]
  leadActivities LeadActivity[]

  // CRM (etapa 2)
  conversations Conversation[]
  chatMessages  ChatMessage[]
  quickReplies  QuickReply[]

  // CRM (API oficial, transmissões, robô e automações)
  whatsappCloudAccount WhatsAppCloudAccount?
  messageTemplates     MessageTemplate[]
  broadcasts           Broadcast[]
  broadcastRecipients  BroadcastRecipient[]
  stageAutomations     StageAutomation[]
  automationRuns       AutomationRun[]
  chatbotFlows         ChatbotFlow[]
  captureRules         CaptureRule[]

  // Financeiro completo
  financialAccounts     FinancialAccount[]
  financialCategories   FinancialCategory[]
  costCenters           CostCenter[]
  finContacts           FinContact[]
  finPaymentMethods     FinPaymentMethod[]
  finPaymentMethodFees  FinPaymentMethodFee[]
  financialTitles       FinancialTitle[]
  financialAllocations  FinancialTitleAllocation[]
  financialTransactions FinancialTransaction[]
  cardReceivables       CardReceivable[]
  cashSessions          CashSession[]
  cashSessionCounts     CashSessionCount[]
  walletEntries         WalletEntry[]
  renegotiations        Renegotiation[]
  renegotiationTitles   RenegotiationTitle[]
  recurrenceRules       RecurrenceRule[]
  appointmentItems      AppointmentItem[]
  financialPermissions  FinancialPermission[]
  financialAttachments  FinancialAttachment[]
  financialReleases     FinancialRelease[]

  @@map("tenants")
}

model User {
  id String @id @default(cuid())

  tenantId String

  /// Conta do Clerk ligada a este acesso.
  ///
  /// Fica nulo quando a pessoa é removida da equipe: `clerkUserId` é único no
  /// banco inteiro, então segurá-lo numa linha desativada impediria a mesma
  /// pessoa de voltar — e voltar tem que ser possível, é o fluxo normal de quem
  /// sai e é recontratado.
  clerkUserId String? @unique

  /// A conta que estava aqui antes da remoção. Só para auditoria: responde
  /// "era a mesma pessoa?" quando alguém é reconvidado meses depois.
  previousClerkUserId String?

  name              String
  email             String
  role              Role      @default(RECEPTIONIST)
  /// Tem acesso ao CRM e conta na cobrança do adicional (R$ por usuário).
  crmSeat           Boolean   @default(false)
  /// Cargo no CRM. Nulo = o padrão do perfil (`lib/crm-roles.ts`).
  crmRole           CrmRole?
  /// Permissões personalizadas no CRM (`lib/crm-rights.ts`). Nulo = as do cargo.
  crmRights         Json?
  /// Entra na distribuição automática de leads e conversas.
  crmReceivesLeads  Boolean   @default(true)
  /// Disponível para receber agora (o "online" do Kommo). Ausente fica fora do rodízio.
  crmAvailable      Boolean   @default(true)
  /// Último lead ou conversa recebido pela distribuição: o rodízio dá para quem recebeu há mais tempo.
  crmLastAssignedAt DateTime?
  /// Unidades em que a pessoa trabalha (agenda). Vazio = todas.
  unitIds           String[]  @default([])
  /// Bandeira operacional: é ela que todas as consultas filtram.
  /// `deactivatedAt` é o registro do fato; as duas são escritas juntas.
  active            Boolean   @default(true)

  /// Quando o acesso foi encerrado, por quem e por quê. Nulo enquanto ativo.
  deactivatedAt      DateTime?
  deactivatedById    String?
  deactivationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                Tenant         @relation(fields: [tenantId], references: [id])
  patientNotes          PatientNote[]
  auditLogs             AuditLog[]
  assignedLeads         Lead[]         @relation("LeadAssignee")
  assignedTasks         LeadTask[]     @relation("LeadTaskAssignee")
  chatMessagesSent      ChatMessage[]
  assignedConversations Conversation[] @relation("ConversationAssignee")
  cashSessions          CashSession[]

  @@index([tenantId])
  @@index([tenantId, deactivatedAt])
  @@map("users")
}

model Patient {
  id                 String    @id @default(cuid())
  tenantId           String
  controlNumber      Int
  name               String
  nickname           String?
  cpfEncrypted       String?   @map("cpf")
  /// Índice cego do CPF (`hashForTenant('cpf:' + dígitos)`): acha o CPF
  /// repetido sem abrir a tabela. Nulo = sem CPF, ou paciente antigo que o
  /// relógio do CRM ainda não preencheu.
  cpfHash            String?
  phoneEncrypted     String    @map("phone")
  phone2Encrypted    String?   @map("phone2")
  email              String?
  birthDate          DateTime?
  gender             String?
  maritalStatus      String?
  profession         String?
  referredBy         String?
  notes              String?
  zipCode            String?
  street             String?
  addressNumber      String?
  complement         String?
  neighborhood       String?
  city               String?
  state              String?
  /// Aceite do tratamento dos dados para o atendimento. Obrigatório no cadastro.
  lgpdConsentAt      DateTime?
  /// Aceite separado para receber campanha promocional. Nulo = nunca autorizou.
  ///
  /// Separado do `lgpdConsentAt` de propósito: aquele cobre tratar o paciente e
  /// guardar o prontuário, que tem base legal própria e não depende de
  /// autorização. Disparo promocional em massa é outra finalidade e precisa de
  /// aceite específico — e é também o que a política do WhatsApp exige para o
  /// número não ser derrubado por denúncia.
  marketingConsentAt DateTime?
  /// Patient asked to stop receiving campaigns (replied SAIR/PARAR).
  whatsappOptOut     Boolean   @default(false)
  active             Boolean   @default(true)
  deletedAt          DateTime?
  createdById        String?
  updatedById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  patientNotes       PatientNote[]
  appointments       Appointment[]
  quotes             Quote[]
  messages           WhatsAppMessage[]
  toothFindings      ToothFinding[]
  payments           Payment[]
  anamnesis          Anamnesis?
  evolutions         Evolution[]
  files              PatientFile[]
  campaignRecipients CampaignRecipient[]
  leads              Lead[]
  conversations      Conversation[]
  financialTitles    FinancialTitle[]
  walletEntries      WalletEntry[]

  @@unique([tenantId, controlNumber])
  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, deletedAt])
  @@index([tenantId, cpfHash])
  @@map("patients")
}

model PatientNote {
  id        String   @id @default(cuid())
  tenantId  String
  patientId String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([patientId, createdAt(sort: Desc)])
  @@map("patient_notes")
}

model Professional {
  id                String   @id @default(cuid())
  tenantId          String
  userId            String?  @unique
  name              String
  specialty         String?
  /// Registro no conselho de classe (ex.: "CRO-SP 12345"). Sai nos documentos
  /// em que este profissional é o responsável pelo tratamento.
  registration      String?
  color             String?
  /// Percentual de comissão (repasse) sobre a produção do profissional. Nulo = sem comissão.
  commissionPercent Decimal? @db.Decimal(5, 2)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant        Tenant                 @relation(fields: [tenantId], references: [id])
  schedules     ProfessionalSchedule[]
  appointments  Appointment[]
  blockedSlots  BlockedSlot[]
  procedures    Procedure[]            @relation("ProcedureProfessionals")
  evolutions    Evolution[]
  toothFindings ToothFinding[]
  quotes        Quote[]

  @@index([tenantId])
  @@map("professionals")
}

model ProfessionalSchedule {
  id             String  @id @default(cuid())
  professionalId String
  dayOfWeek      Int
  startTime      String
  endTime        String
  lunchStart     String?
  lunchEnd       String?
  /// Em que unidade atende nesse dia. Nulo = a principal.
  unitId         String?

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  unit         ClinicUnit?  @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@unique([professionalId, dayOfWeek])
  @@map("professional_schedules")
}

model ProcedureCategory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  color     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  procedures Procedure[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("procedure_categories")
}

model Procedure {
  id                 String   @id @default(cuid())
  tenantId           String
  categoryId         String?
  name               String
  description        String?
  basePrice          Decimal  @db.Decimal(10, 2)
  durationMinutes    Int
  prepTimeMinutes    Int?
  color              String?
  internalCode       String?
  materials          String?
  allowsDiscount     Boolean  @default(false)
  maxDiscountPercent Decimal? @db.Decimal(5, 2)

  /// De quantos em quantos dias este procedimento se repete.
  ///
  /// Nulo quando não se repete: restauração, endodontia e implante são feitos
  /// uma vez e acabou. Limpeza volta a cada 6 meses, manutenção de aparelho
  /// todo mês — é isso que diz quando o paciente está "vencido" para voltar.
  recurrenceIntervalDays Int?
  /// Quantos dias além do vencimento ainda contam como normal. Passou disso, a
  /// pessoa está atrasada de verdade.
  recurrenceGraceDays    Int? @default(120)

  active      Boolean   @default(true)
  deletedAt   DateTime?
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  category         ProcedureCategory? @relation(fields: [categoryId], references: [id])
  professionals    Professional[]     @relation("ProcedureProfessionals")
  appointments     Appointment[]
  quoteItems       QuoteItem[]
  interestedLeads  Lead[]
  toothFindings    ToothFinding[]
  appointmentItems AppointmentItem[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, categoryId])
  @@map("procedures")
}

model Appointment {
  id                 String            @id @default(cuid())
  tenantId           String
  patientId          String
  professionalId     String
  procedureId        String?
  startTime          DateTime
  endTime            DateTime
  status             AppointmentStatus @default(SCHEDULED)
  type               AppointmentType   @default(PARTICULAR)
  notes              String?
  cancelReason       String?
  /// Rótulo colorido do horário (atraso, débito, primeira vez…), escolhido pela clínica.
  labelId            String?
  /// Chegou na clínica: entra na sala de espera.
  arrivedAt          DateTime?
  /// Entrou para o atendimento.
  startedAt          DateTime?
  /// Terminou o atendimento (junto com status ATTENDED).
  finishedAt         DateTime?
  /// Unidade onde acontece. Nulo = a principal (agendamentos de antes das unidades).
  unitId             String?
  /// Situação financeira (financeiro completo). Nulo = agendamento de antes dos itens.
  billingStatus      BillingStatus?
  /// "Não cobrar": motivo, quando e quem.
  noChargeReason     String?
  noChargeAt         DateTime?
  noChargeById       String?
  /// Convênio que paga este agendamento (cadastro de clientes e fornecedores). Só no tipo convênio.
  insuranceContactId String?
  createdById        String?
  updatedById        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  patient      Patient           @relation(fields: [patientId], references: [id])
  professional Professional      @relation(fields: [professionalId], references: [id])
  procedure    Procedure?        @relation(fields: [procedureId], references: [id])
  label        AppointmentLabel? @relation(fields: [labelId], references: [id], onDelete: SetNull)
  unit         ClinicUnit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  messages     WhatsAppMessage[]
  items        AppointmentItem[]

  @@index([tenantId, professionalId, startTime])
  @@index([tenantId, billingStatus, startTime])
  @@index([tenantId, unitId, startTime])
  @@index([tenantId, startTime])
  @@index([tenantId, status])
  @@map("appointments")
}

/// Rótulos da agenda: etiquetas coloridas que a clínica cria e põe nos horários.
model AppointmentLabel {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  /// Uma das cores do CRM (`CRM_COLORS`): gray, blue, teal, green, amber, orange, red, pink, violet.
  color     String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  appointments Appointment[]

  @@unique([tenantId, name])
  @@index([tenantId, order])
  @@map("appointment_labels")
}

model BlockedSlot {
  id             String   @id @default(cuid())
  tenantId       String
  professionalId String
  startTime      DateTime
  endTime        DateTime
  reason         String?
  createdAt      DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])

  @@index([tenantId, professionalId, startTime])
  @@map("blocked_slots")
}

model Quote {
  id            String       @id @default(cuid())
  tenantId      String
  patientId     String
  number        Int
  publicToken   String       @unique
  status        QuoteStatus  @default(DRAFT)
  discountType  DiscountType @default(PERCENT)
  discountValue Decimal      @default(0) @db.Decimal(10, 2)
  subtotal      Decimal      @db.Decimal(10, 2)
  total         Decimal      @db.Decimal(10, 2)
  notes         String?
  internalNotes String?
  validUntil    DateTime
  sentAt        DateTime?
  viewedAt      DateTime?
  acceptedAt    DateTime?
  rejectedAt    DateTime?
  rejectReason  String?
  pdfUrl        String?

  /// Quem vai executar o tratamento. Sai no orçamento e no contrato.
  professionalId String?
  /// Condições de pagamento. `installments` conta as parcelas do saldo, depois
  /// da entrada; entrada igual ao total é pagamento à vista. Método nulo = a
  /// combinar. Ver `lib/payment-terms.ts`.
  paymentMethod  String?
  downPayment    Decimal @default(0) @db.Decimal(10, 2)
  installments   Int     @default(1)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  patient      Patient           @relation(fields: [patientId], references: [id])
  professional Professional?     @relation(fields: [professionalId], references: [id])
  items        QuoteItem[]
  messages     WhatsAppMessage[]
  payments     Payment[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("quotes")
}

model QuoteItem {
  id              String   @id @default(cuid())
  quoteId         String
  procedureId     String?
  name            String
  description     String?
  unitPrice       Decimal  @db.Decimal(10, 2)
  quantity        Int      @default(1)
  discountPercent Decimal? @default(0) @db.Decimal(5, 2)
  total           Decimal  @db.Decimal(10, 2)

  quote     Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  procedure Procedure? @relation(fields: [procedureId], references: [id])

  @@index([quoteId])
  @@map("quote_items")
}

model WhatsAppMessage {
  id            String           @id @default(cuid())
  tenantId      String
  patientId     String
  appointmentId String?
  quoteId       String?
  direction     MessageDirection
  templateName  String?
  content       String
  status        MessageStatus    @default(PENDING)

  /// WhatsApp's own id for the message. Doubles as the "this was really handed
  /// to WhatsApp" marker: the gateway stamps it the moment the socket accepts,
  /// so a retry can tell an unsent row from one whose HTTP reply we simply lost.
  externalId String?

  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())

  /// Outbox bookkeeping. The row is written *before* the first attempt, so a
  /// crash, a timeout or a redeploy mid-send leaves something to retry instead
  /// of a patient who was never told and a clinic that never found out.
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  /// Lembrete da agenda: quantos dias antes da consulta ele saiu (um por dia escolhido).
  /// Nulo nos lembretes antigos, que eram todos de 1 dia.
  reminderDays  Int?
  /// When the next attempt becomes due. Null once the row is settled — either
  /// handed to WhatsApp or failed for a reason no retry would fix.
  nextAttemptAt DateTime?

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  patient     Patient      @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  quote       Quote?       @relation(fields: [quoteId], references: [id])

  @@index([tenantId, appointmentId])
  @@index([tenantId, patientId, createdAt(sort: Desc)])
  @@index([externalId])
  @@index([status, nextAttemptAt])
  @@map("whatsapp_messages")
}

/// Uma marcação do odontograma: o que o dente tem ou vai ter, em quais faces.
/// Substituiu a tabela antiga `tooth_records` (uma situação por dente), já
/// copiada para cá (docs/producao/2026-10-28-odontograma.sql).
model ToothFinding {
  id             String             @id @default(cuid())
  tenantId       String
  patientId      String
  toothNumber    Int
  /// Faces: M (mesial), D (distal), O (oclusal/incisal), V (vestibular),
  /// L (lingual/palatina). Vazio: o dente todo.
  surfaces       String[]           @default([])
  /// O que é: catálogo em `lib/odontogram.ts` (CARIES, RESTORATION, ROOT_CANAL…).
  kind           String
  status         ToothFindingStatus @default(PLANNED)
  note           String?
  /// Procedimento da tabela da clínica (dá o valor no plano e no orçamento).
  procedureId    String?
  professionalId String?
  doneAt         DateTime?
  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  procedure    Procedure?    @relation(fields: [procedureId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])

  @@index([tenantId, patientId])
  @@map("tooth_findings")
}

/**
 * Health questionnaire (one per patient). Answers stored as JSON:
 * { items: { [key]: { value: 'yes'|'no', detail?: string } }, obs?: string }
 */
model Anamnesis {
  id          String   @id @default(cuid())
  tenantId    String
  patientId   String   @unique
  answers     Json
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId])
  @@map("anamneses")
}

/**
 * Clinical evolution entry — what was done in a visit/session.
 */
model Evolution {
  id             String   @id @default(cuid())
  tenantId       String
  patientId      String
  professionalId String?
  description    String
  teeth          Int[]    @default([])
  createdById    String?
  createdAt      DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])

  @@index([tenantId, patientId, createdAt(sort: Desc)])
  @@map("evolutions")
}

/**
 * Image/document attached to a patient (stored in Supabase Storage).
 */
model PatientFile {
  id          String   @id @default(cuid())
  tenantId    String
  patientId   String
  bucketPath  String
  filename    String
  mimeType    String
  sizeBytes   Int
  description String?
  createdById String?
  createdAt   DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, patientId, createdAt(sort: Desc)])
  @@map("patient_files")
}

model Payment {
  id          String   @id @default(cuid())
  tenantId    String
  patientId   String
  quoteId     String?
  amount      Decimal  @db.Decimal(10, 2)
  method      String?
  notes       String?
  paidAt      DateTime @default(now())
  createdById String?
  createdAt   DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])
  quote   Quote?  @relation(fields: [quoteId], references: [id])

  @@index([tenantId, patientId, paidAt(sort: Desc)])
  @@map("payments")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Lifecycle of a clinic's own WhatsApp line, paired over the WhatsApp Web
/// protocol (QR code). One line per tenant.
enum WhatsAppConnectionStatus {
  DISCONNECTED
  CONNECTING
  QR_PENDING
  CONNECTED
  ERROR
}

model WhatsAppSession {
  id       String                   @id @default(cuid())
  tenantId String                   @unique
  status   WhatsAppConnectionStatus @default(DISCONNECTED)

  // `status` até `disconnectedAt`: da conexão antiga por QR, que saiu do sistema.
  // Ficam até a limpeza do banco (docs/producao/2026-11-10-limpeza-qr.sql).
  /// Number the clinic paired, in E.164 digits (no mask). Filled on connect.
  phoneNumber String?
  displayName String?

  /// Short-lived pairing payload. Cleared as soon as the socket is open.
  qrCode      String?
  qrExpiresAt DateTime?

  lastError      String?
  connectedAt    DateTime?
  disconnectedAt DateTime?

  /// Quais mensagens da agenda a clínica quer mandar.
  notifyOnCreate  Boolean @default(true)
  notifyReminder  Boolean @default(true)
  notifyBirthday  Boolean @default(false)
  /// Textos escolhidos pela clínica. Nulo = usa o texto padrão do sistema.
  /// Aceitam {nome}, {clinica}, {data}, {hora}, {profissional} e {procedimento}.
  birthdayMessage String?
  createdMessage  String?
  reminderMessage String?
  /// Quantos dias antes da consulta sai cada lembrete (0 = no dia, de manhã).
  reminderDays    Int[]   @default([1])
  /// Botões de cada aviso da agenda: [{ payload, text }]. Nulo = Confirmar e Reagendar.
  createdButtons  Json?
  reminderButtons Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([status])
  @@map("whatsapp_sessions")
}

enum CampaignStatus {
  DRAFT
  SENDING
  DONE
  CANCELLED
}

/// A bulk WhatsApp send (promotions, recalls, seasonal greetings). Delivery is
/// paced by the gateway rather than fired at once: a burst from a QR-paired
/// number is what gets a clinic's line banned.
model Campaign {
  id       String         @id @default(cuid())
  tenantId String
  name     String
  message  String
  status   CampaignStatus @default(DRAFT)

  total  Int @default(0)
  sent   Int @default(0)
  failed Int @default(0)

  createdById String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  recipients CampaignRecipient[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("campaigns")
}

model CampaignRecipient {
  id         String        @id @default(cuid())
  tenantId   String
  campaignId String
  patientId  String
  status     MessageStatus @default(PENDING)
  error      String?
  sentAt     DateTime?
  createdAt  DateTime      @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  patient  Patient  @relation(fields: [patientId], references: [id])

  @@unique([campaignId, patientId])
  @@index([campaignId, status])
  @@map("campaign_recipients")
}

// ─── Assinatura (cobrança do DreamClin pelas clínicas) ───────────────────────
// Distinto de `Payment`, que é o dinheiro que o *paciente* paga para a clínica.

enum PlanTier {
  ESSENCIAL
  PROFISSIONAL
  CLINICA
}

enum SubscriptionStatus {
  TRIALING // avaliação gratuita, acesso total
  ACTIVE // em dia
  PAST_DUE // venceu, dentro da tolerância — ainda acessa
  SUSPENDED // tolerância esgotada — somente leitura
  CANCELLED // encerrada a pedido da clínica
}

enum ChargeStatus {
  PENDING
  PAID
  OVERDUE
  REFUNDED
  CANCELLED
}

/// Um plano vendável. Os limites moram aqui, e não no código, para que mudar
/// preço ou liberar um recurso não exija deploy.
model Plan {
  tier                 PlanTier @id
  name                 String
  description          String
  monthlyPriceCents    Int
  /// Teto de profissionais; null = ilimitado.
  maxProfessionals     Int?
  whatsappEnabled      Boolean  @default(true)
  campaignsEnabled     Boolean  @default(false)
  assistantEnabled     Boolean  @default(false)
  advancedReports      Boolean  @default(false)
  /// Preço do CRM por usuário com acesso, por mês. O CRM é um adicional pago
  /// por cima de qualquer plano (docs/specs/2026-10-09-crm-adicional-pago-design.md).
  crmSeatPriceCents    Int      @default(3900)
  /// O plano "com CRM": quanto o CRM soma à mensalidade, já com `crmIncludedSeats`
  /// usuários; cada usuário a mais paga `crmSeatPriceCents`. 0 = só por usuário.
  crmPackagePriceCents Int      @default(0)
  crmIncludedSeats     Int      @default(0)
  /// O produto só CRM, sem a agenda: o CRM sozinho, já com `crmIncludedSeats`
  /// usuários (docs/specs/2026-10-26-planos-teste-e-funis-design.md). Maior que
  /// o pacote: quem leva os dois paga menos pelo CRM.
  crmOnlyPriceCents    Int      @default(0)
  /// Ordem de exibição na tela de planos.
  sortOrder            Int      @default(0)
  active               Boolean  @default(true)

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id       String   @id @default(cuid())
  tenantId String   @unique
  tier     PlanTier

  status SubscriptionStatus @default(TRIALING)

  trialEndsAt        DateTime?
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  /// Fim da tolerância após o vencimento. Passou disso, vira SUSPENDED.
  graceEndsAt        DateTime?
  cancelledAt        DateTime?

  /// Cortesia: acesso completo e nenhuma cobrança, concedida por nós.
  ///
  /// Bandeira à parte, e não mais um valor de `status`, de propósito: o status
  /// é reescrito pela reconciliação e pelo webhook do Asaas a partir das datas,
  /// e uma cortesia não pode depender de nenhum dos dois lembrar que ela existe.
  /// `resolveAccess` olha para cá antes de qualquer data.
  complimentary     Boolean @default(false)
  /// Por que foi concedida — para quem ler a tabela daqui a um ano.
  complimentaryNote String?

  /// Identificadores no Asaas. Nulos enquanto a cobrança for manual.
  asaasCustomerId     String?
  asaasSubscriptionId String?

  /// Módulo Agenda (a gestão clínica: agenda, pacientes, prontuário,
  /// orçamentos, financeiro). Desligado = a clínica contratou só o CRM.
  clinicEnabled    Boolean   @default(true)
  /// Módulo CRM contratado. Desligado por padrão: clínica sem CRM não vê
  /// nada novo e a automação do funil não faz nada para ela.
  crmEnabled       Boolean   @default(false)
  /// Fim dos 14 dias grátis do CRM. Preenchido também marca que o teste já foi
  /// usado: ligar e desligar não dá um teste novo.
  crmTrialEndsAt   DateTime?
  /// Último valor mensal enviado ao Asaas (plano + CRM). Só se manda de novo
  /// quando o cálculo der diferente — a rotina diária pode rodar à vontade.
  billedValueCents Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  plan    Plan     @relation(fields: [tier], references: [tier])
  charges Charge[]

  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

/// Uma fatura. Guardamos os links do Asaas para a clínica pagar sem sair do
/// sistema — o boleto e o QR do PIX são o que ela realmente precisa.
model Charge {
  id             String       @id @default(cuid())
  tenantId       String
  subscriptionId String
  amountCents    Int
  status         ChargeStatus @default(PENDING)
  dueDate        DateTime
  paidAt         DateTime?

  asaasChargeId String? @unique
  invoiceUrl    String?
  bankSlipUrl   String?
  pixPayload    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, dueDate(sort: Desc)])
  @@map("charges")
}

/// Convite para alguém entrar numa clínica que já existe.
///
/// O Clerk manda o e-mail e a pessoa define a própria senha no cadastro — o que
/// guardamos aqui é a intenção: quem foi convidado, para qual clínica e com qual
/// perfil. Guardar do nosso lado também é o que faz o vínculo funcionar mesmo se
/// o metadata do convite não chegar ao usuário: no onboarding procuramos um
/// convite pendente para o e-mail já verificado pelo Clerk.
model Invitation {
  id                String           @id @default(cuid())
  tenantId          String
  /// Sempre em minúsculas — é a chave de busca no onboarding.
  email             String
  role              Role
  status            InvitationStatus @default(PENDING)
  /// Id do convite no Clerk, para conseguir revogar lá também.
  clerkInvitationId String?
  invitedById       String?
  createdAt         DateTime         @default(now())
  acceptedAt        DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Um convite pendente por e-mail por clínica. Reconvidar atualiza o que existe.
  @@unique([tenantId, email])
  @@index([email, status])
  @@map("invitations")
}

// ─── CRM ────────────────────────────────────────────────────────────────────
//
// Captação de pacientes no estilo Kommo. O lead é um negócio, não a pessoa: a
// mesma pessoa pode ter vários ao longo do tempo ("Implante" hoje,
// "Harmonização" ano que vem). Enquanto não é paciente, o contato mora no
// próprio lead; depois de convertido, `patientId` aponta para a ficha.
//
// Toda tabela daqui tem `tenantId`, inclusive as de ligação: `getTenantClient`
// filtra todo modelo por ele, e uma tabela sem a coluna quebraria as consultas.
// Ver docs/specs/2026-10-07-crm-etapa1-leads-funil-design.md.

/// Papel de uma etapa para a automação. A automação procura a etapa pelo
/// papel, nunca pelo nome — assim a clínica renomeia à vontade.
enum StageRole {
  NEW
  SCHEDULED
  /// Desmarcou ou faltou na avaliação: a agenda move para cá.
  CANCELLED
  /// Compareceu à avaliação: a agenda move para cá.
  ATTENDED
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  WHATSAPP
  INDICACAO
  INSTAGRAM
  SITE
  MANUAL
  OUTRO
  /// Anúncio do Facebook (clique para o WhatsApp).
  FACEBOOK
}

enum LeadActivityType {
  CREATED
  STAGE_CHANGED
  NOTE
  TAG_ADDED
  TAG_REMOVED
  ASSIGNED
  TASK_CREATED
  TASK_COMPLETED
  CONVERTED
  LOST
  REOPENED
  /// Algo que aconteceu na agenda ou nos orçamentos do paciente ligado.
  CLINIC_EVENT
  /// Mudou um campo personalizado ({ fieldId, name, from, to }).
  FIELD_CHANGED
}

enum TaskOrigin {
  MANUAL
  /// Criada pela integração com a agenda e os orçamentos (ex.: "Reagendar avaliação").
  AUTOMATION
}

model Lead {
  id       String @id @default(cuid())
  tenantId String

  /// Nome do negócio ("Implante"). Vazio: a tela mostra o interesse ou o nome.
  title          String?
  /// Nome da pessoa. Copiado do paciente quando o lead é ligado a um.
  name           String
  phoneEncrypted String  @map("phone")
  /// HMAC do telefone normalizado com a chave da clínica. Serve só para achar
  /// lead duplicado sem decifrar todos os telefones.
  phoneHash      String
  email          String?

  stageId        String
  /// Ordem dentro da coluna do quadro.
  position       Int      @default(0)
  /// Quando entrou na etapa atual — o card mostra "há 3 dias".
  stageEnteredAt DateTime @default(now())

  assignedToId        String?
  source              LeadSource @default(MANUAL)
  interestProcedureId String?
  estimatedValueCents Int?
  notes               String?

  /// Pediu para não receber mais mensagens (respondeu SAIR). Transmissões e
  /// automações pulam; a conversa continua.
  whatsappOptOut Boolean @default(false)

  /// Campos personalizados da clínica: { [LeadField.id]: valor }. Regras em `crm/custom-fields.ts`.
  fields Json @default("{}")

  /// Paciente ligado. Não é único de propósito: vários negócios por pessoa.
  patientId    String?
  lostReasonId String?

  /// Lead "aberto" = os três nulos.
  wonAt     DateTime?
  lostAt    DateTime?
  deletedAt DateTime?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  stage               PipelineStage        @relation(fields: [stageId], references: [id])
  assignedTo          User?                @relation("LeadAssignee", fields: [assignedToId], references: [id])
  interestProcedure   Procedure?           @relation(fields: [interestProcedureId], references: [id])
  patient             Patient?             @relation(fields: [patientId], references: [id])
  lostReason          LostReason?          @relation(fields: [lostReasonId], references: [id])
  tasks               LeadTask[]
  tags                LeadTagOnLead[]
  activities          LeadActivity[]
  conversations       Conversation[]
  broadcastRecipients BroadcastRecipient[]
  automationRuns      AutomationRun[]

  @@index([tenantId, stageId, position])
  @@index([tenantId, phoneHash])
  @@index([tenantId, patientId])
  @@index([tenantId, assignedToId])
  @@index([tenantId, deletedAt])
  @@map("leads")
}

/// Um funil do CRM ("Funil principal", "Harmonização"…), como no Kommo. Toda
/// clínica tem ao menos um; o de menor `order` é o principal, onde entra o lead
/// novo quando ninguém diz o funil.
model Pipeline {
  id       String @id @default(cuid())
  tenantId String
  name     String
  order    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  stages PipelineStage[]

  @@index([tenantId, order])
  @@map("pipelines")
}

model PipelineStage {
  id         String     @id @default(cuid())
  tenantId   String
  pipelineId String
  name       String
  /// Nome de um token da paleta do app, não um hex livre.
  color      String
  order      Int
  /// Null = etapa criada pela clínica, que a automação não conhece.
  role       StageRole?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  pipeline    Pipeline          @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads       Lead[]
  automations StageAutomation[]

  /// Cada papel no máximo uma vez por funil. No Postgres nulos não colidem
  /// num índice único, então as etapas sem papel ficam livres.
  @@unique([pipelineId, role])
  @@index([tenantId, order])
  @@index([pipelineId, order])
  @@map("pipeline_stages")
}

model LeadTask {
  id       String @id @default(cuid())
  tenantId String
  leadId   String

  text          String
  dueAt         DateTime
  assignedToId  String
  completedAt   DateTime?
  completedById String?
  origin        TaskOrigin @default(MANUAL)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  lead       Lead   @relation(fields: [leadId], references: [id])
  assignedTo User   @relation("LeadTaskAssignee", fields: [assignedToId], references: [id])

  @@index([tenantId, leadId, completedAt])
  /// "Minhas tarefas": pendentes de uma pessoa, por vencimento.
  @@index([tenantId, assignedToId, completedAt, dueAt])
  @@map("lead_tasks")
}

/// Campo personalizado do lead (como no Kommo): convênio, como conheceu… O valor
/// fica em `Lead.fields`, pela id. Desativado some das telas e guarda os valores.
model LeadField {
  id         String        @id @default(cuid())
  tenantId   String
  name       String
  type       LeadFieldType
  /// Opções das listas (SELECT e MULTISELECT), na ordem de exibição.
  options    String[]      @default([])
  order      Int           @default(0)
  showOnCard Boolean       @default(false)
  active     Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, order])
  @@map("lead_fields")
}

enum LeadFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  MULTISELECT
  BOOLEAN
}

model LeadTag {
  id       String @id @default(cuid())
  tenantId String
  name     String
  color    String

  createdAt DateTime @default(now())

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  leads  LeadTagOnLead[]

  @@unique([tenantId, name])
  @@map("lead_tags")
}

model LeadTagOnLead {
  tenantId String
  leadId   String
  tagId    String

  createdAt DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  lead   Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag    LeadTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@index([tenantId, tagId])
  @@map("lead_tags_on_leads")
}

model LostReason {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  order    Int
  active   Boolean @default(true)

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  leads  Lead[]

  @@unique([tenantId, name])
  @@map("lost_reasons")
}

model LeadActivity {
  id       String           @id @default(cuid())
  tenantId String
  leadId   String
  type     LeadActivityType
  /// Detalhe do evento (ex.: { from, to }, { tagId }, { appointmentId }).
  /// Nunca telefone nem outro dado pessoal.
  data     Json?
  /// Null = foi a automação.
  actorId  String?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  lead   Lead   @relation(fields: [leadId], references: [id])

  @@index([tenantId, leadId, createdAt(sort: Desc)])
  @@map("lead_activities")
}

// ─── CRM etapa 2: conversas do WhatsApp ──────────────────────────────────────

enum ConversationStatus {
  /// Número que ninguém conhece ainda: espera alguém aceitar ou recusar.
  INBOX
  ACTIVE
  /// Recusada na Entrada. Volta para a Entrada se a pessoa escrever de novo.
  DECLINED
}

enum ChatOrigin {
  /// Escrita pelo contato.
  CONTACT
  /// Escrita no CRM por alguém da equipe.
  CRM
  /// Escrita no celular (ou WhatsApp Web) da clínica.
  PHONE
  /// Lembrete, confirmação ou campanha do sistema.
  AUTOMATION
  /// Transmissão do CRM.
  BROADCAST
  /// Robô ou automação por etapa do CRM.
  BOT
}

enum ChatKind {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  LOCATION
  CONTACT
  OTHER
}

/// Um número de WhatsApp = uma conversa, como no celular. Gravada pelo gateway
/// só para clínicas com o CRM ligado.
model Conversation {
  id       String @id @default(cuid())
  tenantId String

  phoneEncrypted String  @map("phone")
  /// Índice cego da chave de conversa (telefone normalizado, celular sempre com
  /// o 9). Gateway e app calculam igual — ver `chatKey`.
  phoneHash      String
  /// O nome que a pessoa usa no WhatsApp.
  contactName    String?

  status       ConversationStatus @default(INBOX)
  leadId       String?
  patientId    String?
  /// Quem atende esta conversa. Anda junto com o responsável do negócio aberto
  /// (`crm/assignment.ts`); conversa de paciente sem negócio também tem o seu.
  assignedToId String?
  /// Quando o app já tentou ligar a lead ou paciente. Nulo = falta tentar.
  classifiedAt DateTime?

  unreadCount          Int       @default(0)
  /// A última palavra é do contato: ninguém da clínica respondeu ainda.
  awaitingReply        Boolean   @default(false)
  lastMessageAt        DateTime  @default(now())
  /// Começo da última mensagem, cifrado (é conversa de clínica).
  lastPreviewEncrypted String?   @map("lastPreview")
  /// Última mensagem do contato. Na API oficial, define a janela de 24 horas.
  lastInboundAt        DateTime?

  /// Robô ativo nesta conversa (nulo = nenhum).
  botFlowId    String?
  botStepId    String?
  botStartedAt DateTime?
  /// Respostas que o robô não entendeu seguidas; na segunda, passa para a equipe.
  botMisses    Int       @default(0)
  /// Quando o robô acorda sozinho ("sem resposta" na mensagem, ou a pausa). O relógio do CRM acorda.
  botWakeAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  lead                Lead?                @relation(fields: [leadId], references: [id])
  patient             Patient?             @relation(fields: [patientId], references: [id])
  assignedTo          User?                @relation("ConversationAssignee", fields: [assignedToId], references: [id])
  botFlow             ChatbotFlow?         @relation(fields: [botFlowId], references: [id], onDelete: SetNull)
  messages            ChatMessage[]
  broadcastRecipients BroadcastRecipient[]

  @@unique([tenantId, phoneHash])
  @@index([tenantId, lastMessageAt(sort: Desc)])
  @@index([tenantId, status, lastMessageAt(sort: Desc)])
  @@index([tenantId, leadId])
  @@index([tenantId, assignedToId])
  @@index([botWakeAt])
  @@map("conversations")
}

model ChatMessage {
  id             String @id @default(cuid())
  tenantId       String
  conversationId String

  direction     MessageDirection
  origin        ChatOrigin
  kind          ChatKind         @default(TEXT)
  /// Texto ou legenda, cifrado. Nulo em mídia sem legenda.
  textEncrypted String?          @map("text")
  /// Id da mensagem no WhatsApp. Único por clínica: é o que impede gravar duas
  /// vezes a mesma mensagem (o gateway vê a própria saída de volta).
  externalId    String
  status        MessageStatus    @default(SENT)
  /// Quem escreveu, quando foi pelo CRM.
  sentById      String?
  /// Hora da mensagem no WhatsApp.
  at            DateTime         @default(now())

  /// Modelo aprovado usado (API oficial) e os valores das variáveis, em ordem.
  templateName   String?
  templateLang   String?
  templateParams Json?
  /// Mídia na API oficial: id na Meta, buscado sob demanda (nada é guardado).
  mediaRef       String?
  mimeType       String?
  /// Opções do robô: [{ id, title }]. Botões na API oficial; no QR o texto já
  /// traz as opções numeradas.
  buttons        Json?
  /// Anúncio de onde a pessoa veio (clique para o WhatsApp), na 1ª mensagem:
  /// { sourceId, sourceUrl, headline, body, mediaType, imageUrl, … } (`CloudAd`).
  ad             Json?

  /// Fila do envio pelo CRM. `acceptedAt` = o WhatsApp aceitou; daí em diante
  /// quem manda no status são os acks.
  acceptedAt    DateTime?
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  /// Reserva de quem está enviando agora, para o envio direto e a rotina de
  /// reenvio não mandarem a mesma linha ao mesmo tempo.
  claimedUntil  DateTime?
  errorMessage  String?

  createdAt DateTime @default(now())

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  conversation       Conversation        @relation(fields: [conversationId], references: [id])
  sentBy             User?               @relation(fields: [sentById], references: [id])
  broadcastRecipient BroadcastRecipient?

  @@unique([tenantId, externalId])
  @@index([tenantId, conversationId, at])
  /// A rotina de reenvio do gateway.
  @@index([status, nextAttemptAt])
  @@map("chat_messages")
}

/// Respostas prontas da clínica, chamadas com "/" na caixa de texto.
model QuickReply {
  id       String @id @default(cuid())
  tenantId String
  /// O atalho ("horarios"). Único na clínica.
  title    String
  /// O texto. Aceita {nome}.
  body     String
  order    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, title])
  @@map("quick_replies")
}

// ─── CRM: API oficial, transmissões, robô e automações ──────────────────────

enum CloudAccountStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

/// A conta da clínica na API oficial do WhatsApp (Cloud API da Meta). Ativa e
/// conectada, ela é o canal das conversas do CRM no lugar do gateway de QR.
model WhatsAppCloudAccount {
  id       String @id @default(cuid())
  tenantId String @unique

  wabaId               String
  /// Único no sistema: é por ele que o webhook da Meta descobre a clínica.
  phoneNumberId        String             @unique
  displayPhone         String?
  verifiedName         String?
  /// Token de acesso, cifrado com a chave da clínica. Nunca vai para a tela.
  accessTokenEncrypted String             @map("accessToken")
  /// O número continua no app WhatsApp Business do celular (coexistência).
  coexistence          Boolean            @default(false)
  /// Conectada pelo formulário de teste (número de teste da Meta).
  manual               Boolean            @default(false)
  active               Boolean            @default(true)
  status               CloudAccountStatus @default(CONNECTED)
  lastError            String?
  connectedAt          DateTime           @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("whatsapp_cloud_accounts")
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum TemplateStatus {
  APPROVED
  PENDING
  REJECTED
  PAUSED
  DISABLED
}

/// Modelo de mensagem aprovado pela Meta. Fora da janela de 24 horas, é o único
/// jeito de escrever pela API oficial.
model MessageTemplate {
  id       String @id @default(cuid())
  tenantId String

  name           String
  language       String           @default("pt_BR")
  category       TemplateCategory
  status         TemplateStatus   @default(PENDING)
  /// Texto do corpo, com {{1}}, {{2}}…
  body           String
  variables      Int              @default(0)
  components     Json?
  externalId     String?
  rejectedReason String?
  lastSyncedAt   DateTime?
  /// Modelo dos avisos da agenda: APPOINTMENT_CREATED ou APPOINTMENT_REMINDER.
  /// Nulo = modelo do CRM (transmissões, conversas).
  purpose        String?
  /// Ordem das variáveis da agenda: ["nome", "data", …] = {{1}}, {{2}}, …
  varKeys        Json?
  /// O texto da clínica que gerou este modelo (com {nome}, {data}…).
  sourceText     String?
  /// Botões do modelo da agenda, na ordem: [{ payload, text }]. Nulo = Confirmar e Reagendar.
  buttons        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  broadcasts Broadcast[]

  @@unique([tenantId, name, language])
  @@index([tenantId, purpose])
  @@map("message_templates")
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  DONE
  CANCELLED
}

enum BroadcastRecipientStatus {
  /// Mensagem criada na fila (o andamento está na própria mensagem).
  QUEUED
  /// Não recebe: pediu para sair, sem telefone válido…
  SKIPPED
  CANCELLED
}

/// Transmissão do CRM para um grupo de leads.
model Broadcast {
  id       String          @id @default(cuid())
  tenantId String
  name     String
  status   BroadcastStatus @default(DRAFT)

  /// Mensagem livre (gateway de QR). Aceita {nome}.
  text           String?
  /// Modelo aprovado (API oficial).
  templateId     String?
  /// Valor de cada variável do modelo, em ordem: texto fixo ou "{nome}".
  templateParams Json?
  /// Quem recebe: { stageIds, tagIds, sources, assignedToIds }.
  audience       Json

  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  cancelledAt DateTime?
  total       Int       @default(0)
  skipped     Int       @default(0)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant               @relation(fields: [tenantId], references: [id])
  template   MessageTemplate?     @relation(fields: [templateId], references: [id])
  recipients BroadcastRecipient[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([status, scheduledAt])
  @@map("broadcasts")
}

model BroadcastRecipient {
  id             String                   @id @default(cuid())
  tenantId       String
  broadcastId    String
  leadId         String
  conversationId String?
  chatMessageId  String?                  @unique
  status         BroadcastRecipientStatus @default(QUEUED)
  skipReason     String?

  createdAt DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  broadcast    Broadcast     @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  lead         Lead          @relation(fields: [leadId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  chatMessage  ChatMessage?  @relation(fields: [chatMessageId], references: [id], onDelete: SetNull)

  @@unique([broadcastId, leadId])
  @@index([tenantId, broadcastId])
  @@map("broadcast_recipients")
}

enum AutomationAction {
  SEND_MESSAGE
  CREATE_TASK
  ADD_TAG
  ASSIGN_USER
  RUN_BOT
  REMOVE_TAG
  MOVE_STAGE
}

/// Quando a automação da etapa dispara: o lead entrou (criado ou movido),
/// só quando foi criado nela, ou só quando foi movido para ela.
enum StageTrigger {
  ENTER
  CREATED
  MOVED
}

enum AutomationRunStatus {
  PENDING
  DONE
  SKIPPED
  FAILED
}

/// O que acontece quando um lead entra numa etapa (o "funil digital" do Kommo).
model StageAutomation {
  id           String           @id @default(cuid())
  tenantId     String
  stageId      String
  action       AutomationAction
  /// SEND_MESSAGE { text } ou { templateId, params } · CREATE_TASK { text, dueHours,
  /// assignTo: "responsible" | userId } · ADD_TAG / REMOVE_TAG { tagIds } (antigas: { tagId })
  /// · ASSIGN_USER { userId } · RUN_BOT { flowId } · MOVE_STAGE { stageId }
  config       Json
  trigger      StageTrigger     @default(ENTER)
  /// Só dispara se bater: { days?: number[] (0 = domingo), from?: "HH:MM", to?: "HH:MM",
  /// sources?: LeadSource[], tagIds?: string[] } (`crm/stage-automation-rules.ts`).
  conditions   Json             @default("{}")
  delayMinutes Int              @default(0)
  active       Boolean          @default(true)
  order        Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  stage  PipelineStage   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  runs   AutomationRun[]

  @@index([tenantId, stageId])
  @@map("stage_automations")
}

model AutomationRun {
  id             String              @id @default(cuid())
  tenantId       String
  automationId   String
  leadId         String
  dueAt          DateTime
  /// A entrada na etapa que disparou. Se o lead saiu e voltou, é outra execução.
  stageEnteredAt DateTime
  status         AutomationRunStatus @default(PENDING)
  error          String?
  doneAt         DateTime?

  createdAt DateTime @default(now())

  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  automation StageAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  lead       Lead            @relation(fields: [leadId], references: [id])

  @@index([status, dueAt])
  @@index([tenantId, leadId])
  @@map("automation_runs")
}

enum ChatbotTrigger {
  /// Primeira mensagem de um número que ninguém conhece.
  NEW_CONTACT
  /// A mensagem é uma das palavras-chave.
  KEYWORD
  /// O lead foi criado ou movido para uma das etapas (`steps.trigger.stageIds`).
  STAGE
  /// Uma das tags foi posta no lead (`steps.trigger.tagIds`).
  TAG
  /// A clínica falou por último e a pessoa não responde há X horas (`steps.trigger.hours`).
  NO_REPLY
}

/// Robô por botões: um menu, com submenus, respostas e ações.
model ChatbotFlow {
  id       String         @id @default(cuid())
  tenantId String
  name     String
  active   Boolean        @default(false)
  trigger  ChatbotTrigger
  keywords String[]       @default([])
  /// Formato 2 (`crm/flow-engine.ts`): { version: 2, start, steps, layout, trigger, hours, audience }.
  /// Robôs antigos (menu de botões) são convertidos na leitura (`crm/flow-legacy.ts`).
  steps    Json
  /// Contadores do rodízio ({ [stepId]: n }).
  state    Json           @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  conversations Conversation[]

  @@index([tenantId, active])
  @@map("chatbot_flows")
}

/// Captação: palavras na primeira mensagem de um número que viram lead já com
/// tag, funil e origem (ex.: "implante" → tag implante no funil Implantes).
/// Roda antes do robô (`crm/capture.ts`). `tagIds` e `pipelineId` sem chave
/// estrangeira: tag apagada é ignorada e funil apagado cai no principal.
model CaptureRule {
  id         String      @id @default(cuid())
  tenantId   String
  name       String
  active     Boolean     @default(true)
  keywords   String[]    @default([])
  tagIds     String[]    @default([])
  pipelineId String?
  source     LeadSource?
  order      Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, active])
  @@map("capture_rules")
}

/// Unidade da clínica (filial), como no Clínica nas Nuvens: endereço, telefone,
/// horário e agenda próprios. Pacientes, orçamentos, financeiro e CRM são da
/// clínica toda. A principal é a de menor `order` (nunca desativada); toda
/// clínica tem uma, criada a partir dos dados da clínica (`lib/units.ts`).
model ClinicUnit {
  id            String  @id @default(cuid())
  tenantId      String
  name          String
  phone         String?
  email         String?
  /// Endereço em uma linha, montado ao salvar (mensagens e agendamento online).
  address       String?
  zipCode       String?
  street        String?
  addressNumber String?
  complement    String?
  neighborhood  String?
  city          String?
  state         String?
  /// Horário de funcionamento próprio (mesmo formato de `Tenant.settings.businessHours`). Nulo = o da clínica.
  businessHours Json?
  active        Boolean @default(true)
  order         Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  appointments Appointment[]
  schedules    ProfessionalSchedule[]

  @@index([tenantId, order])
  @@map("clinic_units")
}

/// Contadores do limite de tentativas das rotas públicas (apps/web/lib/rate-limit.ts).
/// Fica no banco porque a Vercel roda várias instâncias: um contador na memória
/// de cada uma não limitava nada. `resetAt` em milissegundos, sem fuso horário.
model RateLimit {
  key     String @id
  count   Int
  resetAt BigInt

  @@index([resetAt])
  @@map("rate_limits")
}

// ─── Financeiro completo ─────────────────────────────────
// Spec: docs/specs/2026-11-16-financeiro-completo.md
// Dinheiro em Decimal(12,2); datas sem hora em DATE; competência "AAAA-MM".

enum FinDirection {
  RECEIVABLE
  PAYABLE
}

enum FinTitleStatus {
  OPEN
  PARTIAL
  PAID
  CANCELLED
  RENEGOTIATED
}

/// De onde nasceu um título ou um movimento.
enum FinOrigin {
  MANUAL
  APPOINTMENT
  QUOTE
  COMMISSION
  CARD_FEE
  RENEGOTIATION
  WALLET
  RECURRENCE
  TRANSFER
}

enum FinAccountKind {
  CASH
  BANK
  DIGITAL
}

/// O "documento" de uma forma de recebimento ou pagamento.
enum FinMethodKind {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BOLETO
  TRANSFER
  CHECK
  WALLET
  INSURANCE
  OTHER
}

enum FinTxKind {
  RECEIPT
  PAYMENT
  REINFORCEMENT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  REVERSAL
  FEE
}

enum FinContactKind {
  SUPPLIER
  INSURANCE
  CARD_OPERATOR
  THIRD_PARTY
  OTHER
}

/// Linhas da DRE. A ordem e os sinais ficam em `lib/financeiro/dre.ts`.
enum DreLine {
  RECEITA_BRUTA
  IMPOSTOS
  DEDUCOES_RECEITA
  OUTRAS_RECEITAS
  OUTRAS_DEDUCOES
  CUSTO_SERVICOS
  CUSTO_PRODUTOS
  OUTROS_CUSTOS
  DESPESAS_VARIAVEIS
  RECUPERACAO_VARIAVEIS
  DESPESAS_PESSOAL
  DESPESAS_ADMINISTRATIVAS
  DESPESAS_FINANCEIRAS
  RECUPERACAO_FIXAS
  OUTROS_TRIBUTOS
  INVESTIMENTOS_ATIVOS
  INVESTIMENTOS_SERVICOS
  PROVISAO_IR_CSLL
  PARTICIPACOES
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum WalletReason {
  ADVANCE
  CHANGE
  REVERSAL
  RENEGOTIATION
  USE
  REFUND
}

/// Situação financeira de um agendamento (guardada para filtrar rápido).
enum BillingStatus {
  NONE
  TO_RECEIVE
  BILLED
  PARTIAL
  PAID
  NO_CHARGE
}

/// Onde o dinheiro está: caixa da recepção, banco ou conta digital.
/// O saldo não é guardado: é o saldo inicial mais a soma dos movimentos.
model FinancialAccount {
  id             String         @id @default(cuid())
  tenantId       String
  name           String
  kind           FinAccountKind @default(CASH)
  bankName       String?
  agency         String?
  number         String?
  openingBalance Decimal        @default(0) @db.Decimal(12, 2)
  openingDate    DateTime       @db.Date
  /// Unidade dona da conta. Nulo = a clínica toda.
  unitId         String?
  active         Boolean        @default(true)
  isDefault      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  transactions FinancialTransaction[]
  methods      FinPaymentMethod[]
  cashSessions CashSession[]

  @@index([tenantId, active])
  @@map("financial_accounts")
}

/// Plano de contas em dois níveis. A linha da DRE fica na subcategoria.
model FinancialCategory {
  id        String       @id @default(cuid())
  tenantId  String
  parentId  String?
  name      String
  direction FinDirection
  dreLine   DreLine?
  comment   String?
  active    Boolean      @default(true)
  /// Criada pelo sistema (plano padrão). `systemKey` identifica as que o código usa.
  isSystem  Boolean      @default(false)
  systemKey String?
  order     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  parent   FinancialCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children FinancialCategory[] @relation("CategoryTree")
  titles   FinancialTitle[]

  @@unique([tenantId, systemKey])
  @@index([tenantId, direction, active])
  @@index([tenantId, parentId])
  @@map("financial_categories")
}

model CostCenter {
  id        String   @id @default(cuid())
  tenantId  String
  parentId  String?
  name      String
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  parent   CostCenter?  @relation("CostCenterTree", fields: [parentId], references: [id])
  children CostCenter[] @relation("CostCenterTree")

  @@index([tenantId, parentId])
  @@map("cost_centers")
}

/// Cliente ou fornecedor que não é paciente: fornecedor, convênio, operadora
/// de cartão, profissional terceiro. O documento é cifrado como o CPF do paciente.
model FinContact {
  id                String         @id @default(cuid())
  tenantId          String
  name              String
  /// "PF" ou "PJ".
  personType        String         @default("PJ")
  documentEncrypted String?        @map("document")
  documentHash      String?
  phone             String?
  email             String?
  zipCode           String?
  street            String?
  addressNumber     String?
  complement        String?
  neighborhood      String?
  city              String?
  state             String?
  kind              FinContactKind @default(SUPPLIER)
  notes             String?
  active            Boolean        @default(true)
  createdById       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  titles FinancialTitle[]

  @@index([tenantId, name])
  @@index([tenantId, kind, active])
  @@index([tenantId, documentHash])
  @@map("fin_contacts")
}

/// Forma de recebimento ou pagamento.
model FinPaymentMethod {
  id                String        @id @default(cuid())
  tenantId          String
  name              String
  kind              FinMethodKind
  active            Boolean       @default(true)
  /// "RECEIVE", "PAY" ou "BOTH".
  usage             String        @default("BOTH")
  /// Conta de destino sugerida ao escolher a forma.
  accountId         String?
  requireDocNumber  Boolean       @default(false)
  /// Compensação: "SAME_DAY", "DAYS" (D+N) ou "DAY_OF_MONTH" (dia fixo).
  settlementType    String        @default("SAME_DAY")
  settlementValue   Int?
  /// Cartão: operadora (um contato), máximo de parcelas e para onde vai a taxa.
  operatorContactId String?
  maxInstallments   Int           @default(1)
  feeCategoryId     String?
  feeCostCenterId   String?
  /// Antecipação do cartão (F7): { mode, percent, categoryId, businessDays }.
  anticipation      Json?
  isSystem          Boolean       @default(false)
  order             Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant  Tenant                @relation(fields: [tenantId], references: [id])
  account FinancialAccount?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  fees    FinPaymentMethodFee[]

  @@index([tenantId, active, order])
  @@map("fin_payment_methods")
}

/// Taxa do cartão por faixa de parcelas ("até 1x: 3,2%", "até 6x: 4,5%").
model FinPaymentMethodFee {
  id               String   @id @default(cuid())
  tenantId         String
  methodId         String
  upToInstallments Int
  percent          Decimal? @db.Decimal(6, 3)
  fixed            Decimal? @db.Decimal(12, 2)
  createdAt        DateTime @default(now())

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  method FinPaymentMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)

  @@index([tenantId, methodId])
  @@map("fin_payment_method_fees")
}

/// Título: uma conta a receber ou a pagar. É o "faturar".
model FinancialTitle {
  id                String         @id @default(cuid())
  tenantId          String
  /// Número de exibição, sequencial por clínica.
  code              Int
  direction         FinDirection
  origin            FinOrigin      @default(MANUAL)
  /// Id do agendamento, orçamento, renegociação… conforme a origem.
  originId          String?
  patientId         String?
  contactId         String?
  professionalId    String?
  unitId            String?
  appointmentId     String?
  quoteId           String?
  categoryId        String
  costCenterId      String?
  accountId         String?
  methodId          String?
  issueDate         DateTime       @db.Date
  dueDate           DateTime       @db.Date
  /// Mês de competência, "AAAA-MM".
  competence        String
  amount            Decimal        @db.Decimal(12, 2)
  /// Quanto do valor já foi quitado (soma do `principal` dos movimentos vivos).
  paidAmount        Decimal        @default(0) @db.Decimal(12, 2)
  status            FinTitleStatus @default(OPEN)
  installmentNumber Int            @default(1)
  installmentTotal  Int            @default(1)
  /// Liga as parcelas do mesmo parcelamento.
  groupId           String?
  recurrenceId      String?
  renegotiationId   String?
  document          String?
  documentNumber    String?
  description       String?
  cancelReason      String?
  cancelledAt       DateTime?
  cancelledById     String?
  createdById       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tenant       Tenant                     @relation(fields: [tenantId], references: [id])
  patient      Patient?                   @relation(fields: [patientId], references: [id])
  contact      FinContact?                @relation(fields: [contactId], references: [id])
  category     FinancialCategory          @relation(fields: [categoryId], references: [id])
  transactions FinancialTransaction[]
  allocations  FinancialTitleAllocation[]

  @@unique([tenantId, code])
  @@index([tenantId, direction, status, dueDate])
  @@index([tenantId, patientId, status])
  @@index([tenantId, contactId])
  @@index([tenantId, origin, originId])
  @@index([tenantId, appointmentId])
  @@index([tenantId, quoteId])
  @@index([tenantId, competence])
  @@index([tenantId, groupId])
  @@map("financial_titles")
}

/// Rateio do título entre categorias e centros de custo. A soma bate com o valor.
model FinancialTitleAllocation {
  id           String   @id @default(cuid())
  tenantId     String
  titleId      String
  categoryId   String
  costCenterId String?
  amount       Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  title  FinancialTitle @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@index([tenantId, titleId])
  @@map("financial_title_allocations")
}

/// Movimento: dinheiro que entrou ou saiu de verdade. É o "baixar".
/// Estorno nunca apaga: cria um movimento REVERSAL ligado ao original.
model FinancialTransaction {
  id              String         @id @default(cuid())
  tenantId        String
  code            Int
  kind            FinTxKind
  origin          FinOrigin      @default(MANUAL)
  originId        String?
  titleId         String?
  /// Nulo quando o meio é a carteira do paciente (não movimenta conta).
  accountId       String?
  cashSessionId   String?
  methodId        String?
  methodKind      FinMethodKind?
  patientId       String?
  contactId       String?
  /// Categoria dos movimentos sem título (reforço, sangria, taxa).
  categoryId      String?
  costCenterId    String?
  document        String?
  documentNumber  String?
  /// Dinheiro que andou (sempre positivo).
  amount          Decimal        @db.Decimal(12, 2)
  /// Efeito no saldo da conta: positivo entra, negativo sai, zero na carteira.
  signedAmount    Decimal        @db.Decimal(12, 2)
  /// Quanto do título este movimento quita.
  principal       Decimal        @default(0) @db.Decimal(12, 2)
  discount        Decimal        @default(0) @db.Decimal(12, 2)
  surcharge       Decimal        @default(0) @db.Decimal(12, 2)
  interest        Decimal        @default(0) @db.Decimal(12, 2)
  fine            Decimal        @default(0) @db.Decimal(12, 2)
  installments    Int            @default(1)
  cardBrand       String?
  nsu             String?
  checkBank       String?
  checkNumber     String?
  checkHolder     String?
  checkDate       DateTime?      @db.Date
  paidOn          DateTime       @db.Date
  competence      String
  /// Quando o dinheiro cai na conta (cartão, boleto). Nulo = no dia.
  settlementDate  DateTime?      @db.Date
  /// Vários meios do mesmo recebimento compartilham este id (um recibo só).
  receiptGroupId  String?
  /// As duas pontas de uma transferência compartilham este id.
  transferId      String?
  /// Este movimento é o estorno de outro.
  reversalOfId    String?        @unique
  /// Preenchido no original quando ele foi estornado.
  reversedAt      DateTime?
  reverseReason   String?
  reconciledAt    DateTime?
  statementLineId String?
  /// `Payment` antigo copiado para cá na migração (um para um).
  legacyPaymentId String?        @unique
  /// `Payment` espelho mantido para as telas antigas.
  mirrorPaymentId String?
  description     String?
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  title       FinancialTitle?       @relation(fields: [titleId], references: [id])
  account     FinancialAccount?     @relation(fields: [accountId], references: [id])
  cashSession CashSession?          @relation(fields: [cashSessionId], references: [id])
  reversalOf  FinancialTransaction? @relation("TxReversal", fields: [reversalOfId], references: [id])
  reversal    FinancialTransaction? @relation("TxReversal")
  receivables CardReceivable[]

  @@unique([tenantId, code])
  @@index([tenantId, paidOn])
  @@index([tenantId, accountId, paidOn])
  @@index([tenantId, titleId])
  @@index([tenantId, cashSessionId])
  @@index([tenantId, patientId, paidOn])
  @@index([tenantId, receiptGroupId])
  @@index([tenantId, competence])
  @@index([tenantId, mirrorPaymentId])
  @@map("financial_transactions")
}

/// Uma linha por parcela de cartão (ou por cheque) a compensar.
model CardReceivable {
  id                String    @id @default(cuid())
  tenantId          String
  transactionId     String
  methodId          String?
  operatorContactId String?
  /// "CARD" ou "CHECK".
  kind              String    @default("CARD")
  installmentNumber Int       @default(1)
  installmentTotal  Int       @default(1)
  grossAmount       Decimal   @db.Decimal(12, 2)
  feeAmount         Decimal   @default(0) @db.Decimal(12, 2)
  netAmount         Decimal   @db.Decimal(12, 2)
  expectedDate      DateTime  @db.Date
  /// "OPEN", "RECONCILED", "CANCELLED" ou "RETURNED" (cheque devolvido).
  status            String    @default("OPEN")
  reconciledAt      DateTime?
  anticipatedAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  transaction FinancialTransaction @relation(fields: [transactionId], references: [id])

  @@index([tenantId, status, expectedDate])
  @@index([tenantId, transactionId])
  @@map("card_receivables")
}

/// Sessão de caixa de um usuário numa unidade.
model CashSession {
  id            String            @id @default(cuid())
  tenantId      String
  code          Int
  userId        String
  unitId        String?
  /// A conta de caixa interno que esta sessão movimenta.
  accountId     String
  status        CashSessionStatus @default(OPEN)
  openedAt      DateTime          @default(now())
  openingAmount Decimal           @default(0) @db.Decimal(12, 2)
  closedAt      DateTime?
  closedById    String?
  /// Conferência cega: o contado foi digitado antes de ver o esperado.
  blind         Boolean           @default(false)
  difference    Decimal?          @db.Decimal(12, 2)
  closingNote   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  user         User                   @relation(fields: [userId], references: [id])
  account      FinancialAccount       @relation(fields: [accountId], references: [id])
  transactions FinancialTransaction[]
  counts       CashSessionCount[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, userId, status])
  @@map("cash_sessions")
}

/// Conferência do fechamento, por meio: esperado × contado.
model CashSessionCount {
  id            String        @id @default(cuid())
  tenantId      String
  sessionId     String
  methodKind    FinMethodKind
  expected      Decimal       @db.Decimal(12, 2)
  counted       Decimal       @db.Decimal(12, 2)
  justification String?
  createdAt     DateTime      @default(now())

  tenant  Tenant      @relation(fields: [tenantId], references: [id])
  session CashSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, sessionId])
  @@map("cash_session_counts")
}

/// Carteira do paciente: crédito positivo, uso negativo. Saldo = soma.
model WalletEntry {
  id            String       @id @default(cuid())
  tenantId      String
  patientId     String
  amount        Decimal      @db.Decimal(12, 2)
  reason        WalletReason
  titleId       String?
  transactionId String?
  description   String?
  createdById   String?
  createdAt     DateTime     @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, patientId, createdAt])
  @@map("wallet_entries")
}

model Renegotiation {
  id              String    @id @default(cuid())
  tenantId        String
  code            Int
  patientId       String?
  contactId       String?
  originalTotal   Decimal   @db.Decimal(12, 2)
  correctedTotal  Decimal   @db.Decimal(12, 2)
  discount        Decimal   @default(0) @db.Decimal(12, 2)
  downPayment     Decimal   @default(0) @db.Decimal(12, 2)
  installments    Int       @default(1)
  /// Juros do parcelamento, % ao mês, e o modo: "SIMPLE" ou "PRICE".
  interestPercent Decimal   @default(0) @db.Decimal(6, 3)
  interestMode    String    @default("SIMPLE")
  undoneAt        DateTime?
  undoneById      String?
  createdById     String?
  createdAt       DateTime  @default(now())

  tenant Tenant               @relation(fields: [tenantId], references: [id])
  titles RenegotiationTitle[]

  @@unique([tenantId, code])
  @@index([tenantId, patientId])
  @@map("renegotiations")
}

/// Títulos de uma renegociação: os antigos (com a situação que tinham) e os novos.
model RenegotiationTitle {
  id              String          @id @default(cuid())
  tenantId        String
  renegotiationId String
  titleId         String
  /// "OLD" ou "NEW".
  role            String
  previousStatus  FinTitleStatus?
  createdAt       DateTime        @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  renegotiation Renegotiation @relation(fields: [renegotiationId], references: [id], onDelete: Cascade)

  @@index([tenantId, renegotiationId])
  @@index([tenantId, titleId])
  @@map("renegotiation_titles")
}

/// Lançamento recorrente: o molde do título e de quanto em quanto tempo repete.
model RecurrenceRule {
  id             String    @id @default(cuid())
  tenantId       String
  every          Int       @default(1)
  /// "DAY", "WEEK", "MONTH" ou "YEAR".
  unit           String    @default("MONTH")
  startDate      DateTime  @db.Date
  endDate        DateTime? @db.Date
  occurrences    Int?
  /// Campos do título a repetir (direção, categoria, valor, descrição…).
  template       Json
  /// Último vencimento já gerado.
  generatedUntil DateTime? @db.Date
  active         Boolean   @default(true)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, active])
  @@map("recurrence_rules")
}

/// Itens do agendamento: o que foi feito e quanto custa.
model AppointmentItem {
  id            String   @id @default(cuid())
  tenantId      String
  appointmentId String
  procedureId   String?
  name          String
  quantity      Int      @default(1)
  unitPrice     Decimal  @db.Decimal(12, 2)
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  total         Decimal  @db.Decimal(12, 2)
  /// Veio de um orçamento aprovado: não gera cobrança nova.
  quoteItemId   String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  procedure   Procedure?  @relation(fields: [procedureId], references: [id])

  @@index([tenantId, appointmentId])
  @@index([tenantId, quoteItemId])
  @@map("appointment_items")
}

/// Permissões financeiras de um usuário, por cima do perfil.
model FinancialPermission {
  id                 String   @id @default(cuid())
  tenantId           String
  userId             String   @unique
  /// Limite de desconto em %. Nulo = o padrão da clínica.
  maxDiscountPercent Decimal? @db.Decimal(5, 2)
  /// "RECEIVE", "PAY" ou "BOTH".
  operation          String   @default("BOTH")
  /// Contas liberadas. Vazio = todas.
  accountIds         String[] @default([])
  /// Nulo = o que o perfil diz.
  canReverse         Boolean?
  canSeeReports      Boolean?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("financial_permissions")
}

/// Comprovante, nota ou boleto anexado a um título ou movimento.
model FinancialAttachment {
  id            String   @id @default(cuid())
  tenantId      String
  titleId       String?
  transactionId String?
  bucketPath    String
  filename      String
  mimeType      String
  sizeBytes     Int
  createdById   String?
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, titleId])
  @@index([tenantId, transactionId])
  @@map("financial_attachments")
}

/// Pedido de liberação: alguém precisa passar do próprio limite (desconto,
/// tirar juros) e um dono ou administrador autoriza na tela dele. Vale uma vez
/// e por pouco tempo; no lugar de senha compartilhada.
model FinancialRelease {
  id            String    @id @default(cuid())
  tenantId      String
  /// "DISCOUNT" (desconto acima do limite) ou "WAIVE_LATE" (tirar juros e multa).
  kind          String
  titleId       String?
  /// O que foi pedido: { percent, amountCents, note }.
  payload       Json
  /// "PENDING", "APPROVED", "DENIED".
  status        String    @default("PENDING")
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  usedAt        DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status, createdAt])
  @@index([tenantId, requestedById])
  @@map("financial_releases")
}
